# Softwall Payroll API (production)
SOFTWALL_API_BASE_URL=https://softwall-payroll-api-v2.onrender.com/api

# Optional local development API
# SOFTWALL_API_BASE_URL=http://10.0.2.2:3000/api

# Gemini is OPTIONAL for the Android client.
# Production recommendation: keep the Gemini key on the Softwall API server.
# Do not commit a real key here.
GEMINI_API_KEY=MY_GEMINI_API_KEY
